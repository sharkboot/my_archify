{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/common.schema.json",
  "title": "Archify Shared Definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "locale": {
      "enum": ["en", "zh-CN"]
    },
    "animation": {
      "enum": ["trace", "none"]
    },
    "visualPreset": {
      "enum": ["classic", "signal-flow", "blueprint", "editorial"]
    },
    "qualityProfile": {
      "enum": ["standard", "showcase"]
    },
    "side": {
      "enum": ["left", "right", "top", "bottom"]
    },
    "relationshipWidth": {
      "type": "number",
      "minimum": 0.5
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "componentType": {
      "enum": ["frontend", "backend", "database", "cloud", "security", "messagebus", "external"]
    },
    "brandMark": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "anyOf": [
            { "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
            { "pattern": "^https?://" }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https?://" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "variant": {
      "enum": ["default", "emphasis", "security", "dashed"]
    },
    "legendMode": {
      "enum": ["auto", "all", "hidden"]
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visible": { "type": "boolean" }
      }
    },
    "guidedViews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "focus"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "focus": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "note": { "type": "string", "maxLength": 140 }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dot", "title", "items"],
        "properties": {
          "dot": { "enum": ["cyan", "emerald", "violet", "amber", "rose", "orange", "slate"] },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "detailSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 }
      }
    },
    "codeMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "signature": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "maxLength": 400 },
        "value": { "type": "string", "maxLength": 4000 },
        "doc": { "type": "string", "maxLength": 4000 },
        "code": { "type": "string", "maxLength": 200000 },
        "variant": { "enum": ["default", "emphasis", "security", "dashed"] }
      }
    },
    "codeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": { "const": "code" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "subtitle": { "type": "string", "maxLength": 2000 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 300 },
        "language": { "type": "string", "minLength": 1, "maxLength": 40 },
        "signature": { "type": "string", "maxLength": 4000 },
        "doc": { "type": "string", "maxLength": 8000 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/detailSource" }
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/codeMember" }
        },
        "methods": {
          "type": "array",
          "items": { "$ref": "#/$defs/codeMember" }
        },
        "code": { "type": "string", "maxLength": 400000 },
        "notes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "detailConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "maxLength": 200 },
        "variant": { "$ref": "#/$defs/variant" },
        "fromSide": { "$ref": "#/$defs/side" },
        "toSide": { "$ref": "#/$defs/side" },
        "via": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "nestedDiagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "components"],
      "properties": {
        "kind": { "const": "diagram" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "subtitle": { "type": "string", "maxLength": 2000 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/detailComponent" }
        },
        "connectors": {
          "type": "array",
          "items": { "$ref": "#/$defs/detailConnector" }
        },
        "cards": { "$ref": "#/$defs/cards" }
      }
    },
    "detailComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/componentType" },
        "label": { "type": "string", "minLength": 1 },
        "sublabel": { "type": "string" },
        "tag": { "type": "string" },
        "variant": { "$ref": "#/$defs/variant" },
        "pos": { "$ref": "#/$defs/point" },
        "size": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "summary": { "type": "string", "maxLength": 2000 },
        "detail": { "$ref": "#/$defs/detailPayload" }
      }
    },
    "detailPayload": {
      "oneOf": [
        { "$ref": "#/$defs/nestedDiagram" },
        { "$ref": "#/$defs/codeArtifact" }
      ]
    }
  }
}
